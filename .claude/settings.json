{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(//proc/**)",
      "Read(~/.longbridge/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "WebFetch(domain:openapi.longbridge.com)",
      "WebFetch(domain:openapi.longbridge.cn)",
      "WebFetch(domain:openapi.longportapp.com)",
      "WebFetch(domain:mcp.longbridge.com)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(curl *longbridge*)",
      "Bash(curl *longport*)",
      "mcp__Gmail__*",
      "mcp__Google_Drive__*",
      "mcp__Google_Calendar__*",
      "mcp__Google_Sheets__*",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Google_Sheets__*"
    ]
  }
}
