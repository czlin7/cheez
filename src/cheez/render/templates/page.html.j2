{%- if document %}<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
{%- endif %}
<title>{{ title }}</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Newsreader:opsz,wght@6..72,500;6..72,600&family=Public+Sans:wght@400;500;600;700&display=swap">
<style>
{%- if document %}
:root { padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
img { max-width: 100%; }
[hidden] { display: none !important; }
{%- endif %}
{{ css | safe }}
</style>
{%- if document %}
</head>
<body>
{%- endif %}
<div class="edbar">
  <div class="wrap">
    <a class="wordmark" href="{{ home_href }}" aria-label="Cheez Daily, latest edition">
      <svg viewBox="0 0 18 16" aria-hidden="true"><path d="M1 13.5 L9 2 L17 13.5 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="8" cy="10" r="1.5" fill="var(--rind)"/><circle cx="11.2" cy="11.6" r="0.9" fill="var(--rind)"/></svg>
      Cheez <span class="daily">Daily</span>
    </a>
    <nav aria-label="Sections">
      {%- if has_editorial %}<a href="#brief">Brief</a>{% endif %}
      <a href="#markets">Markets</a>
      {%- if has_featured %}<a href="#focus">In focus</a>{% endif %}
      {%- if has_editorial %}<a href="#ideas">Ideas</a>{% endif %}
      <a href="#portfolio">Portfolio</a>
      <a href="#record">Record</a>
      {%- if archive is not none %}<a href="#archive">Archive</a>{% endif %}
    </nav>
  </div>
</div>
<main id="edition" data-next-expected="{{ next_expected }}" data-edition="{{ edition_id }}">
{{ body | safe }}
</main>
{%- if archive is not none %}
<section class="sec" id="archive" aria-labelledby="h-archive">
  <div class="wrap">
    <div class="sec-head"><h2 id="h-archive">Archive</h2><span class="aside">Every edition, newest first. Opens in place.</span></div>
    {%- if archive %}
    <ul class="archive-list">
      {%- for a in archive %}
      <li><span class="d">{{ a.date_label }}</span><a href="#ed-{{ a.id }}">{{ a.headline }}</a><span class="chip{% if a.status == 'partial' %} warn{% elif a.status == 'failed' %} crit{% endif %}">{{ a.status_label }}</span></li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="muted">This is the first edition.</p>
    {%- endif %}
  </div>
</section>
{%- endif %}
<footer class="colophon">
  <div class="wrap">
    <span>Cheez Daily is a private research briefing generated for one reader. It is not investment advice, it never places or changes orders, and it does not know your circumstances outside the connected account.</span>
    <span>Market data: Yahoo Finance (incl. ICE and CME data), Nasdaq.com — delayed as labelled, informational only, not for trading or redistribution. Official data: U.S. Department of the Treasury. Portfolio data, when connected: Longbridge, read-only.</span>
    <span>Edition {{ edition_id }} · generated {{ generated }}.</span>
  </div>
</footer>
<script>
{{ js | safe }}
</script>
{%- if document %}
</body>
</html>
{%- endif %}
